<Window
    x:Class="MicaSound.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MicaSound.App"
    Title="微声 MicaSound">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部:搜索 -->
        <Grid Grid.Row="0" Padding="24,18,24,8" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox"
                     PlaceholderText="搜索歌曲 / 歌手 / 歌单…"
                     FontSize="16"
                     MinHeight="38"
                     KeyDown="OnSearchKeyDown"/>
            <Button Grid.Column="1" Content="搜索" MinWidth="84"
                    Click="OnSearchClick"/>
        </Grid>

        <!-- 中部:结果列表 -->
        <Grid Grid.Row="1">
            <ListView x:Name="SongList"
                      Padding="8,0,8,8"
                      SelectionMode="Single"
                      IsItemClickEnabled="True"
                      ItemClick="OnSongClick">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:SongItem">
                        <Grid Padding="8,10" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Index}" Opacity="0.45" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind Subtitle}" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="EmptyHint" Text="输入关键词开始搜索"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" IsHitTestVisible="False"/>
        </Grid>

        <!-- 底部:正在播放 -->
        <Border Grid.Row="2" Padding="20,10" CornerRadius="16,16,0,0">
            <Border.Background>
                <SolidColorBrush Color="#22FFFFFF"/>
            </Border.Background>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button x:Name="PlayBtn" Content="▶" Click="OnTogglePlay" MinWidth="44" FontSize="16"/>
                    <StackPanel>
                        <TextBlock x:Name="NowTitle" Text="未播放" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="NowSub" Text="" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
                <Slider x:Name="SeekBar" Grid.Column="1" Minimum="0" Maximum="1" StepFrequency="0.01"/>
            </Grid>
        </Border>
    </Grid>
</Window>